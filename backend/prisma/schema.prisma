generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//
// ENUMS
//

enum Role {
  SUPER_ADMIN
  HR
  CANDIDATE
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CompanyOwnerActivationStatus {
  PENDING
  CONSUMED
  EXPIRED
  REVOKED
}

enum EmailDeliveryType {
  COMPANY_INVITATION
  COMPANY_OWNER_ACTIVATION
}

enum CompanyRole {
  OWNER
  ADMIN
  RECRUITER
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ARCHIVED
}

enum AssessmentType {
  TECHNICAL
  GAMING
  MIXED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum InvitationStatus {
  PENDING
  SENT
  OPENED
  COMPLETED
  EXPIRED
}

enum CandidateAssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ResultStatus {
  PASS
  FAIL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PUBLISH
  UNPUBLISH
  ARCHIVE
  DUPLICATE
}

enum AuditModule {
  AUTH
  USER
  ASSESSMENT
  GAME
  QUESTION
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  CODING
  SQL
  PUZZLE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttachmentType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AttemptAuditEvent {
  ATTEMPT_STARTED
  ATTEMPT_RESUMED

  ANSWER_CREATED
  ANSWER_UPDATED
  ANSWER_VERSION_CONFLICT

  ATTEMPT_SUBMITTED
  ATTEMPT_ALREADY_SUBMITTED

  ATTEMPT_EXPIRED
  ATTEMPT_CANCELLED

  INVALID_TOKEN
  ACCESS_DENIED

  QUESTION_TAMPERING

  ATTEMPT_START_CONFLICT
  ATTEMPT_SUBMIT_CONFLICT
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  ARCHIVED
}

enum JobApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
  WITHDRAWN
}

enum JobApplicationSource {
  DIRECT_UPLOAD
  INBOUND_EMAIL
  MANUAL_ENTRY
}

enum ResumeProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  REVIEW_REQUIRED
  FAILED
}

enum ResumeProcessingSource {
  DIRECT_UPLOAD
  INBOUND_EMAIL
}

enum ResumeFileType {
  PDF
  DOCX
}

enum InboundEmailEventStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

//
// MODELS
//

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String?
  name      String?
  role      Role       @default(HR)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Navigation Properties
  assessments       Assessment[]       @relation("CreatedAssessments")
  candidateProfiles CandidateProfile[]
  auditLogs         AuditLog[]

  jobsCreated      Job[]                   @relation("UserCreatedJobs")
  jobApplications  JobApplication[]        @relation("UserJobApplications")
  resumeProcessing ResumeProcessing[]      @relation("UserResumeProcessing")
  companyMembers   CompanyMember[]
  mailbox          UserMailbox?
  ownerActivation  CompanyOwnerActivation?

  @@index([role])
  @@index([status])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuestionTag[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions QuestionCategory[]
}

model Question {
  id             String             @id @default(cuid())
  type           QuestionType
  difficulty     QuestionDifficulty @default(MEDIUM)
  status         QuestionStatus     @default(DRAFT)
  title          String
  content        String
  explanation    String?
  codeSnippet    String?
  sampleTestCase Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  options           Option[]
  assessmentLinkage AssessmentQuestion[]
  tags              QuestionTag[]
  categories        QuestionCategory[]
  attachments       Attachment[]
  candidateAnswers  CandidateAnswer[]
  attemptQuestions  AttemptQuestion[]
  attemptAuditLogs  AttemptAuditLog[]

  @@index([type])
  @@index([difficulty])
  @@index([status])
}

model Option {
  id          String   @id @default(cuid())
  questionId  String
  sequence    Int
  optionText  String
  isCorrect   Boolean  @default(false)
  explanation String?
  createdAt   DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model QuestionCategory {
  questionId String
  categoryId String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([questionId, categoryId])
}

model Attachment {
  id         String         @id @default(cuid())
  questionId String
  type       AttachmentType
  url        String
  fileName   String?
  fileSize   Int?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Assessment {
  id              String           @id @default(cuid())
  title           String
  description     String?
  type            AssessmentType   @default(TECHNICAL)
  status          AssessmentStatus @default(DRAFT)
  durationMinutes Int              @default(60)
  passingScore    Int              @default(60)
  maximumScore    Int              @default(100)

  createdById String
  createdBy   User   @relation("CreatedAssessments", fields: [createdById], references: [id])

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions        AssessmentQuestion[]
  invitations      Invitation[]
  attempts         CandidateAttempt[]
  attemptAuditLogs AttemptAuditLog[]

  @@index([status])
  @@index([createdById])
}

model AssessmentQuestion {
  assessmentId   String
  questionId     String
  orderIndex     Int    @default(0)
  points         Int    @default(1)
  negativePoints Float  @default(0.0)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([assessmentId, questionId])
}

model CandidateProfile {
  id          String   @id @default(cuid())
  userId      String?  @unique
  companyId   String?
  email       String   @unique
  firstName   String
  lastName    String
  phoneNumber String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User?              @relation(fields: [userId], references: [id])
  company          Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  invitations      Invitation[]
  attempts         CandidateAttempt[]
  attemptAuditLogs AttemptAuditLog[]

  @@index([companyId])
  @@index([companyId, email])
}

model Invitation {
  id           String           @id @default(cuid())
  token        String           @unique
  assessmentId String
  candidateId  String
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  sentAt       DateTime?
  openedAt     DateTime?

  assessment Assessment       @relation(fields: [assessmentId], references: [id])
  candidate  CandidateProfile @relation(fields: [candidateId], references: [id])

  @@index([token])
  @@index([assessmentId, candidateId])
}

model CandidateAttempt {
  id           String                    @id @default(cuid())
  assessmentId String
  candidateId  String
  status       CandidateAssessmentStatus @default(NOT_STARTED)
  score        Float?
  maxScore     Float?
  percentage   Float?
  result       ResultStatus?
  startedAt    DateTime                  @default(now())
  submittedAt  DateTime?
  expiresAt    DateTime
  expiredAt    DateTime?

  assessment Assessment       @relation(fields: [assessmentId], references: [id])
  candidate  CandidateProfile @relation(fields: [candidateId], references: [id])

  attemptQuestions AttemptQuestion[]
  answers          CandidateAnswer[]
  auditLogs        AttemptAuditLog[]

  @@index([assessmentId, candidateId])
  @@index([status])
  @@index([status, expiresAt])
}

model AttemptAuditLog {
  id           String            @id @default(cuid())
  event        AttemptAuditEvent
  attemptId    String?
  candidateId  String?
  assessmentId String?
  questionId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime          @default(now())

  attempt    CandidateAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  candidate  CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assessment Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  question   Question?         @relation(fields: [questionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([attemptId, createdAt])
  @@index([candidateId, createdAt])
  @@index([assessmentId, createdAt])
  @@index([event, createdAt])
  @@index([questionId, createdAt])
}

model AttemptQuestion {
  attemptId        String
  questionId       String
  sequence         Int
  questionSnapshot Json

  attempt  CandidateAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id])
  answers  CandidateAnswer[]

  @@id([attemptId, questionId])
  @@index([attemptId])
}

model CandidateAnswer {
  id                String    @id @default(cuid())
  attemptId         String
  questionId        String
  selectedOptionIds String[]
  answerText        String?
  version           Int       @default(1)
  isCorrect         Boolean?
  marksObtained     Float     @default(0)
  evaluatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attempt         CandidateAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question         @relation(fields: [questionId], references: [id])
  attemptQuestion AttemptQuestion? @relation(fields: [attemptId, questionId], references: [attemptId, questionId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

enum OtpPurpose {
  ASSESSMENT_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

model CandidateOtp {
  id String @id @default(cuid())

  email String

  otpHash String

  purpose OtpPurpose @default(ASSESSMENT_VERIFICATION)

  attemptsCount Int @default(0)

  maxAttempts Int @default(3)

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

model CandidateVerificationSession {
  id String @id @default(cuid())

  candidateId  String
  assessmentId String

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId, assessmentId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model IdempotencyKey {
  idempotencyKey String            @id
  userId         String?
  scope          String
  requestHash    String
  status         IdempotencyStatus
  responseCode   Int?
  responseBody   Json?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, scope])
  @@index([expiresAt])
  @@index([status])
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String?
  code        String    @unique
  status      JobStatus @default(DRAFT)

  inboundEmail String? @unique

  companyId   String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy User     @relation("UserCreatedJobs", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  applications JobApplication[]

  @@index([createdById])
  @@index([companyId])
  @@index([status])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model JobApplication {
  id String @id @default(cuid())

  jobId       String
  candidateId String

  candidateEmail String
  candidateName  String?

  resumeProcessingId String? @unique

  source JobApplicationSource @default(DIRECT_UPLOAD)
  status JobApplicationStatus @default(APPLIED)

  coverLetter String?

  appliedAt DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  candidate User @relation("UserJobApplications", fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  resumeProcessing ResumeProcessing? @relation(fields: [resumeProcessingId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId, status])
  @@index([candidateId, createdAt])
  @@index([candidateEmail])
  @@index([status, appliedAt])
  @@index([resumeProcessingId])
  @@index([deletedAt])
}

model ResumeProcessing {
  id String @id @default(cuid())

  candidateId String?

  source ResumeProcessingSource
  status ResumeProcessingStatus @default(PENDING)

  fileType ResumeFileType
  fileName String
  mimeType String
  fileSize Int

  fileHash String @unique

  storageKey String

  parserVersion String

  extractedData Json?

  confidenceScore Float?

  errorCode    String?
  errorMessage String?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate User? @relation("UserResumeProcessing", fields: [candidateId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  applications JobApplication[]

  @@index([candidateId, createdAt])
  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([processedAt])
}

model InboundEmailEvent {
  id String @id @default(cuid())

  provider          String
  providerMessageId String

  recipientEmail String?
  senderEmail    String?
  subject        String?

  status InboundEmailEventStatus @default(PROCESSING)

  resumeProcessingId String?

  receivedAt  DateTime  @default(now())
  completedAt DateTime?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerMessageId])
  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@index([resumeProcessingId])
}

model Company {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  status      CompanyStatus @default(ACTIVE)
  logoUrl     String?
  logoPath    String?
  website     String?
  industry    String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           CompanyMember[]
  jobs              Job[]
  invitations       CompanyInvitation[]
  auditLogs         AuditLog[]
  candidateProfiles CandidateProfile[]

  @@index([createdAt])
}

model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole @default(RECRUITER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([role])
}

model UserMailbox {
  id             String    @id @default(cuid())
  userId         String    @unique
  provider       String    @default("GOOGLE")
  email          String
  refreshToken   String
  accessToken    String?
  tokenExpiresAt DateTime?
  isSyncActive   Boolean   @default(true)
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([provider, isSyncActive])
  @@index([lastSyncedAt])
}

model CompanyInvitation {
  id             String                  @id @default(cuid())
  companyId      String
  email          String
  role           CompanyRole
  tokenHash      String                  @unique
  encryptedToken String                  @default("")
  status         CompanyInvitationStatus @default(PENDING)

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  emailDelivery EmailDelivery?

  @@index([companyId])
  @@index([companyId, email, status])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model OutboxEvent {
  id          String            @id @default(cuid())
  eventType   String
  aggregateId String?
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now())
  lockedAt    DateTime?
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([eventType, aggregateId])
  @@index([createdAt])
}

model CompanyOwnerActivation {
  id             String                       @id @default(cuid())
  userId         String                       @unique
  tokenHash      String                       @unique
  encryptedToken String
  status         CompanyOwnerActivationStatus @default(PENDING)
  expiresAt      DateTime
  consumedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  emailDelivery EmailDelivery?

  @@index([status, expiresAt])
}

model EmailDelivery {
  id             String              @id @default(cuid())
  type           EmailDeliveryType   @default(COMPANY_INVITATION)
  invitationId   String?             @unique
  activationId   String?             @unique
  recipientEmail String
  status         EmailDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  invitation CompanyInvitation?      @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activation CompanyOwnerActivation? @relation(fields: [activationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([type, status, updatedAt])
  @@index([status, updatedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
