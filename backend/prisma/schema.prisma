generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//
// ENUMS
//

enum Role {
  SUPER_ADMIN
  HR
  CANDIDATE
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ARCHIVED
}

enum AssessmentType {
  TECHNICAL
  GAMING
  MIXED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum InvitationStatus {
  PENDING
  SENT
  OPENED
  COMPLETED
  EXPIRED
}

enum CandidateAssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

enum ResultStatus {
  PASS
  FAIL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PUBLISH
  UNPUBLISH
  ARCHIVE
  DUPLICATE
}

enum AuditModule {
  AUTH
  USER
  ASSESSMENT
  GAME
  QUESTION
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  CODING
  SQL
  PUZZLE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  CODE
  ZIP
  OTHER
}

//
// MODELS
//

model User {
  id String @id @default(cuid())

  email         String  @unique
  emailVerified Boolean @default(false)

  password String

  firstName String
  lastName  String

  role Role @default(CANDIDATE)

  isActive Boolean @default(true)

  tokenVersion Int @default(0)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  assessments          Assessment[]          @relation("UserAssessments")
  candidateAssessments CandidateAssessment[]
  invitationsSent      Invitation[]

  questionVersions  QuestionVersion[]
  questionAuditLogs QuestionAuditLog[]
  questionsCreated  Question[]         @relation("QuestionCreatedBy")
  questionsUpdated  Question[]         @relation("QuestionUpdatedBy")

  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  module AuditModule

  description String?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([module])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Assessment {
  id String @id @default(cuid())

  title        String
  description  String?
  instructions String?

  durationMinutes Int
  passingScore    Int
  maximumScore    Int @default(100)

  maxAttempts Int @default(1)

  type       AssessmentType   @default(MIXED)
  difficulty DifficultyLevel  @default(MEDIUM)
  status     AssessmentStatus @default(DRAFT)

  publishAt DateTime?
  startsAt  DateTime?
  endsAt    DateTime?

  createdById String

  createdBy User @relation("UserAssessments", fields: [createdById], references: [id], onDelete: Restrict)

  games                AssessmentGame[]
  questions            AssessmentQuestion[]
  candidateAssessments CandidateAssessment[]
  invitations          Invitation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([difficulty])
}

model Game {
  id String @id @default(cuid())

  name String

  code String @unique

  description String?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assessments AssessmentGame[]
  results     GameResult[]

  @@index([isActive])
}

model Question {
  id String @id @default(cuid())

  title String

  description String?

  explanation String?

  type QuestionType

  difficulty QuestionDifficulty @default(MEDIUM)

  status QuestionStatus @default(DRAFT)

  marks Int @default(1)

  negativeMarks Float @default(0)

  estimatedTime Int?

  shuffleOptions Boolean @default(true)

  version Int @default(1)

  isActive Boolean @default(true)

  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdById String
  updatedById String?

  createdBy User  @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User? @relation("QuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  categoryId String?

  category QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  options QuestionOption[]

  tags QuestionTag[]

  attachments QuestionAttachment[]

  versions QuestionVersion[]

  auditLogs QuestionAuditLog[]

  assessments AssessmentQuestion[]

  candidateAnswers CandidateAnswer[]

  @@index([type])
  @@index([difficulty])
  @@index([status])
  @@index([categoryId])
  @@index([createdById])
  @@index([updatedById])
  @@index([isActive])
}

model QuestionOption {
  id String @id @default(cuid())

  questionId String

  optionText String

  isCorrect Boolean @default(false)

  sequence Int

  explanation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sequence])
  @@index([questionId])
}

model QuestionCategory {
  id String @id @default(cuid())

  name String @unique

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]

  @@index([isActive])
}

model Tag {
  id String @id @default(cuid())

  name String @unique

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questionTags QuestionTag[]

  @@index([isActive])
}

model QuestionTag {
  id String @id @default(cuid())

  questionId String

  tagId String

  createdAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([questionId, tagId])
  @@index([questionId])
  @@index([tagId])
}

model QuestionAttachment {
  id String @id @default(cuid())

  questionId String

  type AttachmentType

  fileName String

  originalName String

  mimeType String

  fileSize Int

  fileUrl String

  uploadedAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([type])
}

model QuestionVersion {
  id String @id @default(cuid())

  questionId String

  version Int @default(1)

  snapshot Json

  createdById String

  createdAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([questionId, version])
  @@index([questionId])
  @@index([createdById])
}

model QuestionAuditLog {
  id String @id @default(cuid())

  questionId String

  userId String

  action AuditAction

  oldValue Json?

  newValue Json?

  description String?

  createdAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@index([userId])
  @@index([action])
}

model AssessmentGame {
  id String @id @default(cuid())

  assessmentId String
  gameId       String

  sequence Int
  weight   Int @default(1)

  createdAt DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, gameId])
  @@index([assessmentId])
  @@index([gameId])
}

model AssessmentQuestion {
  id String @id @default(cuid())

  assessmentId String
  questionId   String

  sequence Int
  marks    Int @default(1)

  negativeMarks Float @default(0)

  createdAt DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@index([questionId])
  @@index([sequence])
}

model CandidateAssessment {
  id String @id @default(cuid())

  candidateId  String
  assessmentId String

  status        CandidateAssessmentStatus @default(NOT_STARTED)
  attemptNumber Int                       @default(1)

  startedAt   DateTime?
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate  User       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  answers     CandidateAnswer[]
  result      AssessmentResult?
  gameResults GameResult[]

  @@unique([candidateId, assessmentId])
  @@index([candidateId])
  @@index([assessmentId])
  @@index([status])
}

model CandidateAnswer {
  id String @id @default(cuid())

  candidateAssessmentId String

  questionId String

  answer Json

  isCorrect Boolean?

  marksAwarded Int @default(0)

  createdAt DateTime @default(now())

  candidateAssessment CandidateAssessment @relation(fields: [candidateAssessmentId], references: [id], onDelete: Cascade)
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([candidateAssessmentId, questionId])
  @@index([candidateAssessmentId])
  @@index([questionId])
}

model Invitation {
  id String @id @default(cuid())

  assessmentId String

  invitedByUserId String

  email String

  token String @unique

  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  invitedBy  User       @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([assessmentId])
  @@index([invitedByUserId])
  @@index([email])
  @@index([status])
}

model AssessmentResult {
  id String @id @default(cuid())

  candidateAssessmentId String @unique

  score Int

  percentage Float

  status ResultStatus

  feedback String?

  createdAt DateTime @default(now())

  candidateAssessment CandidateAssessment @relation(fields: [candidateAssessmentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model GameResult {
  id String @id @default(cuid())

  candidateAssessmentId String

  gameId String

  score Int

  metrics Json?

  createdAt DateTime @default(now())

  candidateAssessment CandidateAssessment @relation(fields: [candidateAssessmentId], references: [id], onDelete: Cascade)
  game                Game                @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([candidateAssessmentId])
  @@index([gameId])
}
